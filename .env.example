# =============================================================================
# iManage AI Workspace — Sprint 1 (open network) BYO configuration.
#
# Copy the values you need into your azd environment:
#     azd env set <NAME> <value>
# Foundry (project + model) and APIM are BROUGHT BY YOU (referenced, not created).
# The stamp deploys only the web + mock App Services and registers the iManage
# MCP route onto your APIM.
# =============================================================================

# --- azd core ----------------------------------------------------------------
AZURE_ENV_NAME=azure-imanage-dev
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-azure-imanage-dev

# --- BYO Foundry (referenced, not created) -----------------------------------
# Project endpoint from the Foundry portal (…/api/projects/<project>).
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project-name>
# Model deployment name the hosted agent uses.
MODEL_DEPLOYMENT_NAME=<your-model-deployment-name>

# --- BYO APIM (referenced, not created) --------------------------------------
# Your existing APIM. models/agents already route through it; the stamp only
# adds the fine-grained iManage MCP route + policy.
APIM_SERVICE_NAME=<your-apim-service-name>
APIM_RESOURCE_GROUP_NAME=<your-apim-resource-group>
APIM_GATEWAY_URL=https://<your-apim-service-name>.azure-api.net

# --- iManage backend ---------------------------------------------------------
# mock = emulated upstream (deployed by this stamp). live = real cloudimanage.com.
IMANAGE_BACKEND_MODE=mock
# [live only] real iManage MCP base url.
IMANAGE_MCP_URL_LIVE=https://cloudimanage.com/mcp
# Subscription key the MCP policy presents to the upstream (leave blank for mock).
IMANAGE_SUBSCRIPTION_KEY=
