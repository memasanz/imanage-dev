{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "imanageBackendMode": {
      "value": "${IMANAGE_BACKEND_MODE=mock}"
    },
    "foundryProjectEndpoint": {
      "value": "${FOUNDRY_PROJECT_ENDPOINT}"
    },
    "modelDeploymentName": {
      "value": "${MODEL_DEPLOYMENT_NAME=gpt-4o}"
    },
    "apimServiceName": {
      "value": "${APIM_SERVICE_NAME}"
    },
    "apimResourceGroupName": {
      "value": "${APIM_RESOURCE_GROUP_NAME}"
    },
    "apimGatewayUrl": {
      "value": "${APIM_GATEWAY_URL}"
    },
    "imanageMcpUrlLive": {
      "value": "${IMANAGE_MCP_URL_LIVE=https://cloudimanage.com/mcp}"
    },
    "imanageSubscriptionKey": {
      "value": "${IMANAGE_SUBSCRIPTION_KEY=}"
    }
  }
}
