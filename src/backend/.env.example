# iManage backend mode
IMANAGE_BACKEND_MODE=mock
MOCK_UPSTREAM_URL=http://localhost:8080

# Tenant config (non-secret). Field map is a JSON array (see docs/product-spec.md §7.1).
IMANAGE_CUSTOMER_ID=1
IMANAGE_FIELD_MAP=[{"key":"client","source":"custom1","label":"Client","searchable":true,"filterable":true,"show_in_detail":true},{"key":"matter","source":"custom2","label":"Matter","filterable":true,"show_in_detail":true}]

# Optional APIM routing (leave empty for local mock mode).
APIM_BASE_URL=
APIM_SUBSCRIPTION_KEY=

# Optional hosted agent (leave empty to use deterministic local chat, not an LLM).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=
AGENT_RESPONSES_BASE_URL=
MODEL_DEPLOYMENT_NAME=gpt-4o
